# Server only. Never use VITE_ prefixes for credentials.
OPENAI_API_KEY=
ASTRA_MODEL=gpt-6-astra
ASTRA_MAX_OUTPUT_TOKENS=1200
ASTRA_REQUESTS_PER_MINUTE=10
ASTRA_DAILY_REQUEST_LIMIT=100
# Production requires persistent limits; missing configuration fails closed.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Comma-separated exact deployment origins and installed extension ID, if needed.
ASTRA_ALLOWED_ORIGINS=https://part-woad.vercel.app
# X search/history and live SPL deployment are not implemented or enabled.
